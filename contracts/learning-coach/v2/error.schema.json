{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchBridge Learning Coach contract error (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "error"],
  "properties": {
    "contract_version": {"const": "2"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"enum": ["unsupported_version", "unknown_task", "invalid_request", "unknown_source", "invalid_source", "missing_abstract", "invalid_response", "invalid_evidence", "source_mismatch"]},
        "message": {"type": "string", "minLength": 1},
        "retryable": {"const": false}
      }
    }
  }
}
