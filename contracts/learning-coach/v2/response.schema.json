{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchBridge Learning Coach success response (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "source_coverage", "output"],
  "properties": {
    "contract_version": {"const": "2"},
    "task_id": {"enum": ["abstract_explanation", "learning_hints", "term_clarification"]},
    "source_coverage": {"$ref": "#/$defs/coverage"},
    "output": {"type": "object"}
  },
  "oneOf": [
    {"properties": {"task_id": {"const": "abstract_explanation"}, "output": {"$ref": "#/$defs/abstractOutput"}}},
    {"properties": {"task_id": {"const": "learning_hints"}, "output": {"$ref": "#/$defs/hintsOutput"}}},
    {"properties": {"task_id": {"const": "term_clarification"}, "output": {"$ref": "#/$defs/termOutput"}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 800, "pattern": "[^ \\t\\n\\r\\f\\v]"},
    "excerpt": {"type": ["string", "null"], "maxLength": 600},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "origin", "source_id", "full_paper_verified"],
      "properties": {
        "scope": {"enum": ["title_and_abstract", "general_background"]},
        "origin": {"enum": ["user_supplied", "verified_retrieval", "none"]},
        "source_id": {"type": ["string", "null"]},
        "full_paper_verified": {"const": false}
      }
    },
    "abstractOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sections"],
      "properties": {
        "sections": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "focus", "explanation", "supporting_excerpt"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
              "focus": {"enum": ["research_problem", "method", "findings", "limitations"]},
              "explanation": {"$ref": "#/$defs/text"},
              "supporting_excerpt": {"$ref": "#/$defs/excerpt"}
            }
          }
        }
      }
    },
    "hintsOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hints"],
      "properties": {
        "hints": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hint", "supporting_excerpt"],
            "properties": {
              "hint": {"$ref": "#/$defs/text"},
              "supporting_excerpt": {"$ref": "#/$defs/excerpt"}
            }
          }
        }
      }
    },
    "termOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "example"],
      "properties": {
        "definition": {"$ref": "#/$defs/text"},
        "example": {"$ref": "#/$defs/text"}
      }
    }
  }
}
