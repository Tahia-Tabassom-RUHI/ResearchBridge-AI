{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "researchbridge-learning-coach-local",
  "main": "src/local.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "send_metrics": false,
  "build": {"command": "npm run schemas"},
  "dev": {"ip": "127.0.0.1", "port": 8787, "local_protocol": "http"},
  "vars": {"LOCAL_MOCK_ENABLED": "true", "MOCK_SCENARIO": "success"},
  "observability": {"enabled": false}
}
